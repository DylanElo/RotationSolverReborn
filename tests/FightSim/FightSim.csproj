<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the real rotation sources against Fakes.cs (the RotationSolver.Basic/Dalamud surface they touch). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <NoWarn>CS1591;CS0414;CS0169;CS0649;CS8618;CS0108;CS0114;CS8602;CS8604;CS8600;CS8625</NoWarn>
    <BrdRotationSource Condition="'$(BrdRotationSource)' == ''">$(MSBuildThisFileDirectory)../../RotationSolver/RebornRotations/Ranged/BRD_Reborn.cs</BrdRotationSource>
    <MchRebornRotationSource Condition="'$(MchRebornRotationSource)' == ''">$(MSBuildThisFileDirectory)../../RotationSolver/RebornRotations/Ranged/MCH_Reborn.cs</MchRebornRotationSource>
    <MchSyncRotationSource Condition="'$(MchSyncRotationSource)' == ''">$(MSBuildThisFileDirectory)../../RotationSolver/RebornRotations/Ranged/MCH_SyncPlus.cs</MchSyncRotationSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../RotationSolver.Basic/Rotations/Basic/BardRotation.cs" Link="Prod/BardRotation.cs" />
    <Compile Include="../../RotationSolver.Basic/Helpers/WeaveBudget.cs" Link="Prod/WeaveBudget.cs" />
    <Compile Include="../../RotationSolver.Basic/Helpers/TargetAvailability.cs" Link="Prod/TargetAvailability.cs" />
    <Compile Include="../../RotationSolver/Updaters/PlannedMchUtilityWeave.cs" Link="Prod/PlannedMchUtilityWeave.cs" />
    <Compile Include="$(BrdRotationSource)" Link="Prod/BRD_Reborn.cs" />
    <Compile Include="../../RotationSolver/RebornRotations/Ranged/BRD_Plan.cs" Link="Prod/BRD_Plan.cs" />
    <Compile Include="../../RotationSolver/RebornRotations/FRUPad.cs" Link="Prod/FRUPad.cs" />
    <Compile Include="../../RotationSolver.Basic/Rotations/Basic/MachinistRotation.cs" Link="Prod/MachinistRotation.cs" />
    <Compile Include="$(MchRebornRotationSource)" Link="Prod/MCH_Reborn.cs" />
    <Compile Include="$(MchSyncRotationSource)" Link="Prod/MCH_SyncPlus.cs" />
    <Compile Include="../../RotationSolver/RebornRotations/Ranged/MCH_Plan.cs" Link="Prod/MCH_Plan.cs" />
    <Compile Include="../../RotationSolver.Basic/Rotations/Basic/BlackMageRotation.cs" Link="Prod/BlackMageRotation.cs" />
    <Compile Include="../../RotationSolver/RebornRotations/Magical/BLM_Default.cs" Link="Prod/BLM_Default.cs" />
    <Compile Include="../../RotationSolver/RebornRotations/Magical/BLM_SyncPlus.cs" Link="Prod/BLM_SyncPlus.cs" />
    <None Include="timeline.py;gen.py;timelines/*.json" />
    <Using Include="RotationSolver.Basic" /><Using Include="RotationSolver.Basic.Actions" /><Using Include="RotationSolver.Basic.Attributes" />
    <Using Include="RotationSolver.Basic.Configuration.RotationConfig" /><Using Include="RotationSolver.Basic.Data" /><Using Include="RotationSolver.Basic.Helpers" />
    <Using Include="RotationSolver.Basic.Rotations" /><Using Include="RotationSolver.Basic.Rotations.Basic" /><Using Include="Dalamud.Game.ClientState.Objects.Types" />
    <Using Include="Dalamud.Game.ClientState.JobGauge.Enums" /><Using Include="Dalamud.Interface" /><Using Include="Dalamud.Bindings.ImGui" />
  </ItemGroup>
  <Target Name="MchDecisionSourceFingerprint" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <MchProductionSource Include="$(MchSyncRotationSource);$(MchRebornRotationSource);../../RotationSolver/RebornRotations/Ranged/MCH_Plan.cs" />
    </ItemGroup>
    <GetFileHash Files="@(MchProductionSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="MchHashedSource" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>MCH.SourceSHA256.%(MchHashedSource.Filename)</_Parameter1>
        <_Parameter2>%(MchHashedSource.FileHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
